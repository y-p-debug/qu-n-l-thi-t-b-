# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO VERCEL & GITHUB
# (Nhập vào Vercel: Project -> Settings -> Environment Variables)
# ==========================================

# 1. Cấu hình Firebase phía Client (Bắt đầu bằng VITE_)
VITE_FIREBASE_API_KEY="AIzaSyAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VITE_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
VITE_FIREBASE_DATABASE_ID=""

# 2. Cấu hình Google Apps Script Webhook (Phía Backend Serverless Functions)
APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/exec"
APPS_SCRIPT_SECRET="dym_secret_key_passphrase_here"

# 3. Mã bí mật bảo vệ endpoint quét quá hạn /api/check-overdue
CRON_SECRET="dym_cron_secret_random_token_123456"

# 4. GitHub Actions Secret (Nhập vào Repo GitHub: Settings -> Secrets and variables -> Actions)
# VERCEL_APP_URL="https://your-project.vercel.app"
# CRON_SECRET="dym_cron_secret_random_token_123456"
